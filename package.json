{
  "name": "pis-lab-site",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-static.mjs",
    "favicon": "node scripts/generate-favicon.mjs",
    "images": "node scripts/optimize-images.mjs",
    "content:studio": "node scripts/content-studio.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "predev": "npm run images && npm run sync && npm run validate:content",
    "dev": "vinext dev --host 127.0.0.1",
    "prebuild": "npm run images && npm run sync && npm run validate:content",
    "build": "vinext build",
    "start": "vinext start --host 127.0.0.1"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  }
}
